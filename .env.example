# PostgreSQL (Supabase or local). Required for Prisma API routes.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sightseeing"

# Public — browser Agora SDK
NEXT_PUBLIC_AGORA_APP_ID=

# Public — browser Google Maps / Places Autocomplete
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only — RTC token generation (never expose to the client)
AGORA_APP_CERTIFICATE=

# Optional — when the Engine runs on another origin, set its base URL and enable CORS there.
# Example: https://api.example.com
NEXT_PUBLIC_API_URL=

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
